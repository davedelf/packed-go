# ==============================================
# USERS SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================
# Copiar este archivo a .env y completar con valores reales

# Server Configuration
SERVER_PORT=8082

# Database Configuration (Docker)
DATABASE_URL=jdbc:postgresql://users-db:5432/users_db
DATABASE_USER=your_users_db_user_here
DATABASE_PASSWORD=your_secure_users_db_password_here

# External Services Configuration
AUTH_SERVICE_URL=http://auth-service:8081

# Logging Configuration
LOGGING_LEVEL_USERS=DEBUG

# ==============================================
# DOCKER COMPOSE VARIABLES
# ==============================================

# Database Container Configuration
POSTGRES_DB=users_db
POSTGRES_USER=your_users_db_user_here
POSTGRES_PASSWORD=your_secure_users_db_password_here